{
  "name": "node-server-api-scheduler",
  "version": "1.0.0",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "description": "Esqueleto de API REST em Node.js, TypeScript e Express; o agendador ainda não foi implementado",
  "author": "Rodolfo Franco (FrancosCorporation)"
}
